DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173

DJANGO_SECRET_KEY=change-me-for-local-development

# Local defaults: SQLite database and files under backend/media/.
DB_ENGINE=sqlite
USE_S3=False
SPEECHBRAIN_MODEL_DIR=ml_models/ecapa

# Required only when DB_ENGINE=postgres
DB_NAME=vas
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Required only when USE_S3=True
AWS_STORAGE_BUCKET_NAME=
AWS_REGION=ap-south-1

# Production only (HTTPS is terminated by the load balancer)
# DEBUG=False
# ALLOWED_HOSTS=api.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SPEECHBRAIN_MODEL_DIR=/app/ml_models/ecapa
